# Copy this to .env and fill in your keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: change ports
FASTAPI_PORT=8000
STREAMLIT_PORT=8501

# Optional: Remote self-hosted ChromaDB server (e.g. Hugging Face Spaces)
# If CHROMA_HOST is left empty, the project defaults to a local persistent database.
CHROMA_HOST=
CHROMA_PORT=
CHROMA_SSL=
CHROMA_AUTH_TOKEN=
CHROMA_TENANT=
CHROMA_DATABASE=

# Optional: Managed Chroma Cloud (trychroma.com)
# If CHROMA_API_KEY is configured, the client automatically uses CloudClient.
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=default_database
# CHROMA_CLOUD_HOST=
# CHROMA_CLOUD_PORT=